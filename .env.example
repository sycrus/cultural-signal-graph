# DeepSeek API key for the cheap extraction model (deepseek-v4-flash).
# Required only for live runs (`python -m cultural_signal_graph`); tests use
# recorded fixtures and never hit the network. Copy to `.env` to set it — it is
# auto-loaded on startup (config.load_dotenv).
DEEPSEEK_API_KEY=

# Optional: Brave Search API key (brave.com/search/api). When set, web search —
# forecast backfill and futures "Ground this" — uses Brave's independent index
# (web + news). Without it, search falls back to Wikipedia full-text.
BRAVE_API_KEY=
